# ========================================================
# MARKET NEWS AI - ENVIRONMENT CONFIGURATION
# ========================================================
# All API keys are 100% OPTIONAL. The application is designed to run
# completely FREE out-of-the-box using the RSS & Yahoo Finance fallback chain.
# If you obtain free-tier API keys, add them below to activate higher-tier providers.

# --------------------------------------------------------
# 1. DATABASE & CACHE SETTINGS
# --------------------------------------------------------
# By default, SQLite is used for local zero-config execution.
# To use PostgreSQL, provide a postgres connection URI:
# DATABASE_URL=postgresql://user:password@localhost:5432/market_news_ai
DATABASE_URL=sqlite:///./backend/market_news.db

# Optional Redis Cache (falls back to SQLite DB cache if unavailable)
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# --------------------------------------------------------
# 2. NEWS PROVIDER KEYS (OPTIONAL)
# --------------------------------------------------------
# Marketaux Free Tier (100 requests/month): https://www.marketaux.com/
MARKETAUX_API_KEY=

# Alpha Vantage Free Tier (25 requests/day): https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# NewsAPI Developer Free Tier (100 requests/day, localhost only): https://newsapi.org/
NEWSAPI_KEY=

# --------------------------------------------------------
# 3. MARKET DATA PROVIDER KEYS (OPTIONAL)
# --------------------------------------------------------
# Alpha Vantage (Used for secondary market data fallback if provided)
# ALPHA_VANTAGE_API_KEY= (shared with news above)

# --------------------------------------------------------
# 4. OPTIONAL LLM INTEGRATION (DEFAULT: OFF)
# --------------------------------------------------------
# The core NLP pipeline uses 100% open-source local VADER + Loughran-McDonald
# financial lexicon and scikit-learn models. No paid LLM is needed.
# Optional external LLM toggle (false by default):
ENABLE_EXTERNAL_LLM=false
EXTERNAL_LLM_PROVIDER=
EXTERNAL_LLM_API_KEY=

# --------------------------------------------------------
# 5. SERVER CONFIGURATION
# --------------------------------------------------------
PORT=8000
HOST=127.0.0.1
DEBUG=true
